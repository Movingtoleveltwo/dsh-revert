{
  "name": "dsh-revert",
  "version": "1.0.5",
  "description": "DeepSeek Harness 现代化对话回退与重试插件：纯 UI 图形交互、原地 Prompt 微调、支持工作区与外部文件双引擎安全恢复。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "revert",
    "rollback",
    "rewind",
    "snapshot",
    "conversation-history",
    "chat"
  ],
  "author": "Movingtoleveltwo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Movingtoleveltwo/dsh-revert.git"
  },
  "homepage": "https://github.com/Movingtoleveltwo/dsh-revert#readme",
  "bugs": {
    "url": "https://github.com/Movingtoleveltwo/dsh-revert/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  }
}
